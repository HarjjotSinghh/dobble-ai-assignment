# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/doctor_appointment
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/doctor_appointment

# LLM Configuration (use any one)
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
LLM_PROVIDER=openai  # openai or anthropic

# Google Calendar API
GOOGLE_CALENDAR_CREDENTIALS_FILE=credentials.json
GOOGLE_CALENDAR_ID=primary

# Email Configuration (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com

# Slack Webhook (for doctor notifications)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# JWT Secret
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# App
APP_ENV=development
FRONTEND_URL=http://localhost:5173
